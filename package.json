{
  "name": "auto-generate-review-product",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:maria-json": "tsx scripts/check-maria-json.ts",
    "check:video-inputs": "tsx scripts/check-video-inputs.ts",
    "check:image-aspect": "tsx scripts/check-image-aspect.ts",
    "check:model-key": "tsx scripts/check-model-key.ts",
    "check:livestream-consistency": "tsx scripts/check-livestream-consistency.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:import": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/migrate-json-to-db.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1110.0",
    "drizzle-orm": "^0.45.2",
    "mysql2": "^3.23.3",
    "next": "14.2.35",
    "playwright": "^1.62.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.35",
    "tsx": "^4.23.12",
    "typescript": "5.5.3"
  }
}
