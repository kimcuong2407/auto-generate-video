{
  "name": "auto-generate-review-product",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:token-retry": "tsx scripts/check-token-retry.ts",
    "check:segment-merge": "tsx scripts/check-segment-merge.ts",
    "check:content-hash-key": "tsx scripts/check-content-hash-key.ts",
    "check:maria-json": "tsx scripts/check-maria-json.ts",
    "check:video-inputs": "tsx scripts/check-video-inputs.ts",
    "check:image-aspect": "tsx scripts/check-image-aspect.ts",
    "check:model-key": "tsx scripts/check-model-key.ts",
    "check:livestream-consistency": "tsx scripts/check-livestream-consistency.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:import": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/migrate-json-to-db.ts",
    "check:extension": "node scripts/check-poller-staleness.mjs && node scripts/check-content-handoff.mjs",
    "check:global-veo-model": "tsx scripts/check-global-veo-model.ts",
    "check:prompt-ref-images": "tsx scripts/check-prompt-ref-images.ts",
    "check:voiceover-length": "tsx scripts/check-voiceover-length.ts",
    "check:stage-bible-stale": "tsx scripts/check-stage-bible-stale.ts",
    "check:ref-image-priority": "tsx scripts/check-ref-image-priority.ts",
    "check:cascade-resume": "tsx scripts/check-cascade-resume.ts",
    "check:media-url-version": "tsx scripts/check-media-url-version.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1110.0",
    "drizzle-orm": "^0.45.2",
    "mysql2": "^3.23.3",
    "next": "14.2.35",
    "playwright": "^1.62.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.35",
    "tsx": "^4.23.12",
    "typescript": "5.5.3"
  }
}
