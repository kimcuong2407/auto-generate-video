# MCP server "Orino Flow" (chạy local, điều khiển Google Flow/Veo + Gemini)
# Lấy token trong app Orino Flow → mục "Bật MCP Server"
ORINO_FLOW_MCP_URL=http://127.0.0.1:51888/mcp
ORINO_FLOW_MCP_TOKEN=

# Thư mục lưu dữ liệu project (ảnh/video/output). Mặc định: <cwd>/data/projects
PROJECTS_DIR=

# Số job Veo tối đa chạy song song khi "Gen tất cả"
FLOW_MAX_CONCURRENT_JOBS=2

# Thời gian tối đa (ms) chờ 1 job gen video trước khi tự đánh dấu lỗi timeout
FLOW_JOB_TIMEOUT_MS=900000

# AI chat API dạng OpenAI-compatible, dùng để sinh nháp kịch bản (nút "Sinh nháp bằng AI")
AI_CHAT_API_URL=
AI_CHAT_API_KEY=
AI_CHAT_API_MODEL=
# Thời gian tối đa (ms) chờ AI trả kịch bản — model có thể mất 30-90s cho 7 scene
AI_CHAT_API_TIMEOUT_MS=180000
# Số lần thử lại khi AI API lỗi tạm thời (524/5xx). Mặc định 2 (tổng 3 lần gọi)
AI_CHAT_API_MAX_RETRIES=2
# Bật đọc stream (SSE) để tránh proxy/Cloudflare cắt ở ~100s (lỗi 524). Mặc định true.
# Đặt false nếu AI API không hỗ trợ streaming (sẽ fallback về gọi thường)
AI_CHAT_API_STREAM=true

# Storyboard ảnh sinh qua Orino Flow (flow_generate_image, cùng tài khoản Google Flow
# dùng cho gen video ở Bước 4) — không cần API key riêng.
# Thời gian tối đa (ms) chờ 1 ảnh storyboard sinh xong
STORYBOARD_IMAGE_TIMEOUT_MS=120000
# Số ảnh storyboard gen song song tối đa khi bấm "Gen tất cả"
STORYBOARD_MAX_CONCURRENT=2

# --- Module Livestream Script (/livestream) ---
# Thư mục lưu dữ liệu job livestream. Mặc định: <cwd>/data/livestream
LIVESTREAM_DIR=
# Model AI hỗ trợ đọc ảnh (vision, qua cùng gateway AI_CHAT_API_*) — dùng để tự đọc ảnh chụp
# màn hình sản phẩm khi link bị chặn (VD Shopee) hoặc khi upload ảnh sản phẩm trực tiếp.
# Model text mặc định (AI_CHAT_API_MODEL) thường KHÔNG hỗ trợ vision — cần chọn model riêng
# hỗ trợ ảnh, VD: cc/claude-haiku-4-5-20251001. Để trống = tắt tính năng đọc ảnh (vẫn dùng
# được, chỉ là phải nhập mô tả sản phẩm thủ công).
AI_VISION_MODEL=
# Bật/tắt fallback fetch link bằng headless browser (Playwright) khi fetch thô thất bại
# (trang render nội dung bằng JS). Mặc định true — cần chạy `npx playwright install chromium`
# sau `npm install`. Đặt false nếu môi trường không cài được Chromium.
LINK_FETCH_USE_BROWSER=true

# --- Cloudflare R2 (lưu trữ video online) ---
# Video từng scene + video ghép cuối (final.mp4) được đẩy lên R2 ngay sau khi tạo ra, để
# xem/tải trực tiếp qua URL public thay vì phụ thuộc route stream file local trên VPS.
# Để trống bất kỳ biến nào bên dưới = tắt tính năng, app fallback về stream file local như cũ.
# Account ID Cloudflare (lấy trong URL endpoint R2 dạng https://<account_id>.r2.cloudflarestorage.com)
R2_ACCOUNT_ID=
# Tạo ở R2 > Manage API Tokens
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Tên bucket R2 dùng để lưu video
R2_BUCKET=
# Domain public đã gắn cho bucket (R2 > bucket > Settings > Custom Domains), vd https://cdn.example.com
R2_PUBLIC_URL=

# --- MariaDB (lưu metadata job/project — media vẫn ở disk/R2) ---
# Cài MariaDB rồi tạo DB + user (chạy trong `sudo mariadb` hoặc `mysql -u root -p`):
#   CREATE DATABASE review_app CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'review'@'localhost' IDENTIFIED BY 'mat-khau-manh';
#   GRANT ALL PRIVILEGES ON review_app.* TO 'review'@'localhost';
#   FLUSH PRIVILEGES;
# Sau khi điền xong 5 biến dưới: `npm run db:migrate` (tạo bảng), rồi `npm run db:import` (nạp JSON cũ, chạy 1 lần).
#
# Host DB, vd 127.0.0.1 (native trên VPS) hoặc IP máy chủ DB riêng
DB_HOST=127.0.0.1
# Cổng MariaDB, mặc định 3306
DB_PORT=3306
# User + mật khẩu DB (khớp CREATE USER ... ở trên)
DB_USER=
DB_PASSWORD=
# Tên database (khớp CREATE DATABASE ... ở trên, vd review_app)
DB_NAME=
# Số kết nối tối đa trong pool (tùy chọn, mặc định 10)
DB_POOL_LIMIT=10

# --- Deploy (GitHub Actions → VPS qua SSH + PM2) ---
# Các biến dưới đây KHÔNG đặt ở đây — chúng là GitHub Secrets, tạo trong:
#   repo GitHub > Settings > Secrets and variables > Actions > New repository secret
# Xem hướng dẫn đầy đủ ở docs/DEPLOY.md
#   VPS_HOST      = IP hoặc hostname VPS, vd 1.2.3.4
#   VPS_USER      = user SSH, vd deploy
#   VPS_PORT      = cổng SSH (tùy chọn, mặc định 22)
#   VPS_SSH_KEY   = private key SSH (toàn bộ nội dung file id_ed25519)
#   VPS_APP_DIR   = đường dẫn app trên VPS, vd /home/deploy/apps/auto-generate-review-product
#   PM2_APP_NAME  = tên process PM2, vd review-app
