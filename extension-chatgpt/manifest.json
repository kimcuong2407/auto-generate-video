{
  "manifest_version": 3,
  "name": "ChatGPT Image Worker",
  "version": "2.0.0",
  "description": "Xác minh phiên chatgpt.com và chạy job gen ảnh cho app review pipeline ngay trong Chrome này.",
  "permissions": [
    "storage",
    "alarms",
    "cookies",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.openai.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://video.homebox.vn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatGPT Image Worker"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}